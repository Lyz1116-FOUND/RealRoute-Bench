{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realroute-bench.local/schemas/solution.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "realroute.problem.v1"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "feasible",
        "infeasible_claim",
        "no_solution",
        "unsupported"
      ]
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vehicle_id": {
            "type": "string",
            "minLength": 1
          },
          "node_ids": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "service_starts": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "required": [
          "vehicle_id",
          "node_ids"
        ],
        "additionalProperties": false
      }
    },
    "reported_objective": {
      "type": "number"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "status",
    "routes"
  ],
  "additionalProperties": false
}
